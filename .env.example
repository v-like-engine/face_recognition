# Face Recognition API Configuration

# API Settings
APP_NAME="Face Recognition API"
APP_VERSION="1.0.0"
API_PREFIX="/api/v1"
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000

# File Upload Settings
UPLOAD_DIR=uploads
KNOWN_FACES_DIR=known_faces
MAX_UPLOAD_SIZE=10485760  # 10 MB in bytes
ALLOWED_EXTENSIONS=".jpg,.jpeg,.png,.bmp"

# Face Recognition Settings
FACE_DETECTION_MODEL=hog  # hog (faster) or cnn (more accurate, requires GPU)
NUM_JITTERS=1  # Higher values = more accurate but slower
TOLERANCE=0.6  # Lower = more strict (0.0-1.0)

# Security (optional)
# SECRET_KEY=your-secret-key-here
# ACCESS_TOKEN_EXPIRE_MINUTES=30
